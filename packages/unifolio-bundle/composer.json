{
    "name": "iuttroyes/unifolio-bundle",
    "type": "symfony-bundle",
    "description": "UnifolioBundle for uniServices - Portfolio de compétences (BUT)",
    "require": {
        "php": "^8.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/uid": "^8.1",
        "doctrine/orm": "*",
        "doctrine/doctrine-bundle": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "UnifolioBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UnifolioBundle\\Tests\\": "tests/"
        }
    }
}
