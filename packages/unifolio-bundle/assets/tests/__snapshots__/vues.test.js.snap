exports[`rendu des écrans (aucun avertissement Vue) > file d'évaluation 1`] = `"<div data-v-app=""><header><h1>À évaluer</h1><p>Les étudiants dont vous êtes chargé(e), par campagne, avec ce qu'il reste à évaluer.</p><!----></header><div class="flex flex-col gap-4"><section class="card p-0 overflow-hidden"><header class="p-4 flex flex-wrap items-center gap-3 border-b border-surface-200"><div class="flex-1 min-w-60"><div class="font-semibold">MMI 2026-2027</div><div class="text-sm text-muted-color">DWeb-DI · MMI - DWeb-DI - 2 · 2026-2027</div></div><span class="p-tag p-component p-tag-info" data-p="info" data-pc-name="tag" pc1="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Dépôt en cours</span></span><span class="p-tag p-component p-tag-danger" data-p="danger" data-pc-name="tag" pc2="" data-pc-section="root"><span class="p-tag-icon pi pi-clock" data-pc-section="icon"></span><span class="p-tag-label" data-pc-section="label">Limite d'évaluation dépassée</span></span><!--v-if--></header><table class="w-full text-left border-collapse text-sm"><thead><tr class="text-muted-color text-xs border-b border-surface-200"><th class="font-medium p-3">Étudiant</th><th class="font-medium p-3 text-center">Traces</th><th class="font-medium p-3 text-center">À évaluer</th><th class="font-medium p-3 text-center">En cours</th><th class="font-medium p-3 text-center">À reprendre</th><th class="font-medium p-3 text-center">En attente de l'étudiant</th><th class="font-medium p-3 text-center">Rendues</th></tr></thead><tbody><tr class="border-b border-surface-100 hover:bg-surface-50 cursor-pointer" tabindex="0"><td class="p-3 font-medium">LAMOUREUX Lauren</td><td class="p-3 text-center">3</td><td class="p-3 text-center"><span class="p-tag p-component p-tag-warn" data-p="warn" data-pc-name="tag" pc3="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">2</span></span></td><td class="p-3 text-center"><span class="p-tag p-component p-tag-info" data-p="info" data-pc-name="tag" pc4="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">1</span></span></td><td class="p-3 text-center"><span class="p-tag p-component p-tag-danger" data-p="danger" data-pc-name="tag" pc5="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">1</span></span></td><td class="p-3 text-center"><span title="1 en attente d'auto-évaluation">1</span></td><td class="p-3 text-center"><span class="text-muted-color">0</span></td></tr></tbody><tfoot><tr><td colspan="7" class="p-3 text-right text-sm font-medium">4 élément(s) restent à traiter</td></tr></tfoot></table></section></div></div>"`;

