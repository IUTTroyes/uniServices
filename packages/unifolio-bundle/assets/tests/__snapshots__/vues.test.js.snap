exports[`rendu des écrans (aucun avertissement Vue) > modération des publications 1`] = `"<div data-v-app=""><header><h1>Modération</h1><p>Portfolios publiés de votre département. Un retrait est immédiat et motivé ; l'étudiant en est informé dans ses réglages de partage.</p><!----></header><div class="flex flex-col gap-3"><div class="card p-4 m-0 flex flex-wrap items-center gap-3"><div class="flex flex-col flex-1 min-w-56"><span class="font-semibold">Ma vitrine</span><span class="text-sm text-muted-color">Lauren LAMOUREUX · version 2 · 7 nov. 2026</span><!--v-if--></div><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc2="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Public</span></span><span class="p-tag p-component p-tag-info" data-p="info" data-pc-name="tag" pc3="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Vitrine</span></span><a href="http://localhost/x" target="_blank" rel="noopener"><button class="p-button p-component p-button-secondary p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Voir" data-pc-name="button" data-p-disabled="false" data-p-severity="secondary" pc4="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-external-link" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Voir</span><!----></button></a><button class="p-button p-component p-button-danger p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Retirer" data-pc-name="button" data-p-disabled="false" data-p-severity="danger" pc5="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-ban" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Retirer</span><!----></button></div><div class="card p-4 m-0 flex flex-wrap items-center gap-3 opacity-70"><div class="flex flex-col flex-1 min-w-56"><span class="font-semibold">Autre</span><span class="text-sm text-muted-color">Paul MARTIN · version 1 · </span><span class="text-sm text-red-600">Retirée : Hors sujet</span></div><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc6="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Établissement</span></span><span class="p-tag p-component p-tag-success" data-p="success" data-pc-name="tag" pc7="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Académique</span></span><!--v-if--><button class="p-button p-component p-button-secondary p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Rétablir" data-pc-name="button" data-p-disabled="false" data-p-severity="secondary" pc8="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-undo" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Rétablir</span><!----></button></div></div><!--teleport start--><!--teleport end--></div>"`;

