exports[`rendu des écrans (aucun avertissement Vue) > progression de l'étudiant : années, compétences, éléments, échéances 1`] = `"<div data-v-app=""><header><h1>Ma progression</h1><p>Les éléments du référentiel que vos traces démontrent, année par année.</p><button class="p-button p-component" data-p="" type="button" aria-label="Déposer une trace" data-pc-name="button" data-p-disabled="false" pc0="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-plus" data-p="left" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="">Déposer une trace</span><!----></button></header><div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_20rem] items-start"><div class="flex flex-col gap-4"><section class="card p-0 overflow-hidden"><button type="button" class="w-full flex flex-wrap items-center gap-3 p-4 bg-transparent border-0 cursor-pointer text-left" aria-expanded="true"><i class="pi pi-chevron-down" aria-hidden="true"></i><div class="flex-1 min-w-48"><div class="font-semibold">MMI 3</div><div class="text-sm text-muted-color">2026-2027 · par apprentissage critique</div></div><span class="p-tag p-component p-tag-info" data-p="info" data-pc-name="tag" pc2="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Dépôt en cours</span></span><!--v-if--></button><div class="p-4 pt-0 flex flex-col gap-4"><p class="m-0 text-sm text-muted-color">Pas de paramétrage</p></div></section><section class="card p-0 overflow-hidden"><button type="button" class="w-full flex flex-wrap items-center gap-3 p-4 bg-transparent border-0 cursor-pointer text-left" aria-expanded="false"><i class="pi pi-chevron-right" aria-hidden="true"></i><div class="flex-1 min-w-48"><div class="font-semibold">MMI 1</div><div class="text-sm text-muted-color">2026-2027 · par apprentissage critique</div></div><span class="p-tag p-component p-tag-info" data-p="info" data-pc-name="tag" pc3="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Dépôt en cours</span></span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc4="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">1 / 2 couverts</span></span><span class="p-tag p-component p-tag-success" data-p="success" data-pc-name="tag" pc5="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Évalué : 80 %</span></span></button><!--v-if--></section><section class="card p-0 overflow-hidden"><button type="button" class="w-full flex flex-wrap items-center gap-3 p-4 bg-transparent border-0 cursor-pointer text-left" aria-expanded="true"><i class="pi pi-chevron-down" aria-hidden="true"></i><div class="flex-1 min-w-48"><div class="font-semibold">MMI 2</div><div class="text-sm text-muted-color">2026-2027 · par apprentissage critique</div></div><span class="p-tag p-component p-tag-info" data-p="info" data-pc-name="tag" pc6="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Dépôt en cours</span></span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc7="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">1 / 2 couverts</span></span><span class="p-tag p-component p-tag-success" data-p="success" data-pc-name="tag" pc8="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Évalué : 80 %</span></span></button><div class="p-4 pt-0 flex flex-col gap-4"><!--v-if--><article class="rounded-lg p-3 border-l-[6px] flex flex-col gap-2" style="border-left-color: rgb(156, 43, 38); background: rgba(156, 43, 38, 0.07);"><div class="flex flex-wrap items-baseline gap-2"><strong class="flex-1 min-w-40">Comprendre</strong><span class="text-sm">1 / 2</span><span class="text-xs text-muted-color">auto-évaluation 50 %</span><span class="text-xs font-semibold">évalué 80 %</span></div><div class="h-2 rounded-full bg-surface-200 overflow-hidden"