exports[`rendu des écrans (aucun avertissement Vue) > bilan de l'étudiant avec synthèse des évaluations 1`] = `"<div data-v-app=""><header><h1>Auto-évaluation</h1><p>Positionnez-vous sur les compétences de votre année, à partir de vos traces.</p><!--v-if--></header><div class="flex flex-col gap-4"><div class="card p-4 flex flex-wrap items-center gap-4"><div class="flex-1 min-w-60"><div class="text-sm text-muted-color">MMI - DWeb-DI - 2 · bilan par apprentissage critique · BUT — AC</div><div class="font-medium">0 / 1 bilan(s) soumis</div></div><div role="progressbar" class="p-progressbar p-component p-progressbar-determinate w-60" aria-valuemin="0" aria-valuenow="0" aria-valuemax="100" data-p="determinate" data-pc-name="progressbar" pc2="" data-pc-section="root"><div class="p-progressbar-value" style="width: 0%; display: flex;" data-p="determinate" data-pc-section="value"><!----></div></div></div><!--v-if--><section class="card p-0 overflow-hidden border-l-[6px]" style="border-left-color: rgb(156, 43, 38);"><header class="p-4 flex items-center gap-3" style="background: rgba(156, 43, 38, 0.1);"><span class="text-xs font-semibold px-2 py-1 rounded" style="background: rgb(156, 43, 38); color: rgb(255, 255, 255);">Comprendre</span><span class="font-medium text-sm">Comprendre les écosystèmes</span></header><div class="divide-y divide-surface-200"><div class="p-4 flex flex-col gap-3 md:flex-row md:items-start"><div class="flex-1 flex flex-col gap-2"><div class="text-sm"><span class="text-xs font-semibold px-1.5 py-0.5 rounded mr-1" style="background: rgba(156, 43, 38, 0.15); color: rgb(156, 43, 38);">AC21.01</span> Analyser</div><span class="text-xs text-muted-color"> Aucune trace rattachée. <a class="text-primary cursor-pointer">Déposer une trace</a></span></div><div class="flex items-center gap-2 md:w-64 md:justify-end"><!--v-if--><span class="p-tag p-component p-tag-success" data-p="success" title="Synthèse des évaluations de vos enseignants sur les traces de cet élément" data-pc-name="tag" pc3="" data-pc-section="root"><span class="p-tag-icon pi pi-check-circle" data-pc-section="icon"></span><span class="p-tag-label" data-pc-section="label">Évalué : 66 %</span></span><button class="p-button p-component p-button-sm" data-p="small" type="button" aria-label="Faire mon bilan" data-pc-name="button" data-p-disabled="false" pc4="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-plus" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Faire mon bilan</span><!----></button></div></div></div></section></div><!--teleport start--><!--teleport end--></div>"`;

