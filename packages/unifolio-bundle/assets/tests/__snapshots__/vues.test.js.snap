exports[`rendu des écrans (aucun avertissement Vue) > édition d'une trace : trace en évaluation non modifiable, et nouvelle trace 2`] = `"<div data-v-app=""><header><h1>Nouvelle trace</h1><p>Déposez vos preuves, décrivez votre démarche et reliez-les aux compétences de votre année.</p><!--v-if--></header><!--v-if--><div class="grid gap-4 xl:grid-cols-3"><section class="card p-4 flex flex-col gap-3 xl:col-span-3"><div><h3 class="text-base font-semibold m-0">Preuves</h3><p class="text-sm text-muted-color m-0">Commencez par déposer ce que vous avez produit ; vous pourrez compléter la description ensuite.</p></div><div class="flex flex-col gap-4"><div class="rounded-xl border-2 border-dashed p-6 flex flex-col items-center gap-3 text-center transition-colors outline-none focus-visible:ring-2 border-surface-300" tabindex="0" role="region" aria-label="Zone de dépôt des preuves : glissez des fichiers ou collez une capture"><i class="pi pi-cloud-upload text-4xl text-emerald-600"></i><div><p class="font-medium m-0">Glissez vos fichiers ici</p><p class="text-sm text-muted-color m-0"> Images, PDF, vidéos, archives, documents… plusieurs à la fois. Le type est reconnu automatiquement. </p></div><div class="flex flex-wrap justify-center gap-2"><button class="p-button p-component p-button-sm" data-p="small" type="button" aria-label="Choisir des fichiers" data-pc-name="button" data-p-disabled="false" pc23="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-folder-open" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Choisir des fichiers</span><!----></button><button class="p-button p-component p-button-secondary p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Texte" data-pc-name="button" data-p-disabled="false" data-p-severity="secondary" pc24="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-align-left" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Texte</span><!----></button><button class="p-button p-component p-button-secondary p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Code" data-pc-name="button" data-p-disabled="false" data-p-severity="secondary" pc25="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-code" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Code</span><!----></button></div><input type="file" multiple="" class="hidden"><div class="flex w-full max-w-xl gap-2"><input type="text" class="p-inputtext p-component flex-1" data-p="" placeholder="…ou collez un lien (site, YouTube, Figma, dépôt Git…)" aria-label="Ajouter un lien" data-pc-name="inputtext" pc26="" data-pc-section="root"><button class="p-button p-component p-button-sm" data-p="small" type="button" disabled="" aria-label="Ajouter" data-pc-name="button" data-p-disabled="true" pc27="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-link" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Ajouter</span><!----></button></div><small class="text-muted-color">Astuce : cliquez dans cette zone puis collez (Ctrl/Cmd + V) une capture d'écran.</small></div><!--v-if--><!--v-if--><div handle=".poignee" disabled="false" class="grid gap-3 md:grid-cols-2"></div></div></section><div class="xl:col-span-2 flex flex-col gap-4"><section class="card p-4 flex flex-col gap-4"><h3 class="text-base font-semibold m-0">Description</h3><div class="flex flex-col gap-2"><label for="trace-titre" class="font-medium">Titre *</label><input type="text" class="p-inputtext p-component" data-p="" id="trace-titre" maxlength="255" data-pc-name="inputtext" pc28="" data-pc-section="root"></div><div class="grid gap-4 sm:grid-cols-3"><div class="flex flex-col gap-2"><label for="trace-annee" class="font-medium">Année de BUT</label><span id="trace-annee" class="py-2 font-medium">MMI - DWeb-DI - 2 — 2026-2027</span><!--v-if--></div><div class="flex flex-col gap-2"><label for="trace-date" class="font-medium">Date de réalisation</label><span id="trace-date" class="p-datepicker p-component p-inputwrapper" data-p="" data-pc-name="datepicker" pc29="" data-pc-section="root"><input type="text" class="p-inputtext p-component p-datepicker-input" data-p="" id="pv_id_N" role="combobox" autocomplete="off" aria-autocomplete="none" aria-haspopup="dialog" aria-expanded="false" inputmode="none" tabindex="0" data-p-has-dropdown="true" data-p-has-e-icon="false" data-pc-name="pcinputtext" data-pc-extend="inputtext" pc30="" data-pc-section="root"><!----><button class="p-datepicker-dropdown" type="button" aria-label="Choose Date" aria-haspopup="dialog" aria-expanded="false" aria-controls="trace-date_panel" data-pc-section="dropdown"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="p-icon" aria-hidden="true" data-pc-section="dropdownicon"><path d="M10.7838 1.51351H9.83783V0.567568C9.83783 0.417039 9.77804 0.272676 9.6716 0.166237C9.56516 0.0597971 9.42079 0 9.27027 0C9.11974 0 8.97538 0.0597971 8.86894 0.166237C8.7625 0.272676 8.7027 0.417039 8.7027 0.567568V1.51351H5.29729V0.567568C5.29729 0.417039 5.2375 0.272676 5.13106 0.166237C5.02462 0.0597971 4.88025 0 4.72973 0C4.5792 0 4.43484 0.0597971 4.3284 0.166237C4.22196 0.272676 4.16216 0.417039 4.16216 0.567568V1.51351H3.21621C2.66428 1.51351 2.13494 1.73277 1.74467 2.12305C1.35439 2.51333 1.13513 3.04266 1.13513 3.59459V11.9189C1.13513 12.4709 1.35439 13.0002 1.74467 13.3905C2.13494 13.7807 2.66428 14 3.21621 14H10.7838C11.3357 14 11.865 13.7807 12.2553 13.3905C12.6456 13.0002 12.8649 12.4709 12.8649 11.9189V3.59459C12.8649 3.04266 12.6456 2.51333 12.2553 2.12305C11.865 1.73277 11.3357 1.51351 10.7838 1.51351ZM3.21621 2.64865H4.16216V3.59459C4.16216 3.