exports[`rendu des écrans (aucun avertissement Vue) > édition d'une trace : trace en évaluation non modifiable, et nouvelle trace 1`] = `"<div data-v-app=""><header><h1>Modifier la trace</h1><p>Déposez vos preuves, décrivez votre démarche et reliez-les aux compétences de votre année.</p><span class="p-tag p-component p-tag-warn" data-p="warn" data-pc-name="tag" pc23="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">En évaluation</span></span></header><div class="p-message p-component p-message-info mb-4" role="alert" aria-live="assertive" aria-atomic="true" data-p="info" data-pc-name="message" pc24="" data-pc-section="root"><div class="p-message-content-wrapper" data-pc-section="contentwrapper"><div class="p-message-content" data-p="info" data-pc-section="content"><!----><div class="p-message-text" data-p="info" data-pc-section="text"> Cette trace est en cours d'évaluation ou évaluée : elle n'est plus modifiable. </div><!----></div></div></div><div class="grid gap-4 xl:grid-cols-3"><section class="card p-4 flex flex-col gap-3 xl:col-span-3"><div><h3 class="text-base font-semibold m-0">Preuves</h3><p class="text-sm text-muted-color m-0">Commencez par déposer ce que vous avez produit ; vous pourrez compléter la description ensuite.</p></div><div class="flex flex-col gap-4"><!--v-if--><!--v-if--><!--v-if--><div handle=".poignee" disabled="true" class="grid gap-3 md:grid-cols-2"><div class="border border-surface-200 rounded-lg p-3 flex flex-col gap-2"><div class="flex items-center gap-2"><!--v-if--><span class="flex-1 flex items-center gap-2 text-sm text-muted-color"><i class="pi pi-align-left"></i> Texte</span><!--v-if--></div><figure class="flex flex-col gap-2 m-0"><p class="whitespace-pre-line m-0 line-clamp-4">Compte rendu</p><!--v-if--><!--v-if--></figure><!--v-if--></div></div></div></section><div class="xl:col-span-2 flex flex-col gap-4"><section class="card p-4 flex flex-col gap-4"><h3 class="text-base font-semibold m-0">Description</h3><div class="flex flex-col gap-2"><label for="trace-titre" class="font-medium">Titre *</label><input type="text" class="p-inputtext p-component p-filled" disabled="" data-p="" id="trace-titre" maxlength="255" data-pc-name="inputtext" pc25="" data-pc-section="root" value="Maquette"></div><div class="grid gap-4 sm:grid-cols-3"><div class="flex flex-col gap-2"><label for="trace-annee" class="font-medium">Année de BUT</label><span id="trace-annee" class="py-2 font-medium">MMI - DWeb-DI - 2 — 2026-2027</span><!--v-if--></div><div class="flex flex-col gap-2"><label for="trace-date" class="font-medium">Date de réalisation</label><span id="trace-date" class="p-datepicker p-component p-inputwrapper p-inputwrapper-filled" data-p="" data-pc-name="datepicker" pc26="" data-pc-section="root"><input type="text" class="p-inputtext p-component p-filled p-datepicker-input" disabled="" data-p="" id="pv_id_N" role="combobox" autocomplete="off" aria-autocomplete="none" aria-haspopup="dialog" aria-expanded="false" inputmode="none" tabindex="0" data-p-has-dropdown="true" data-p-has-e-icon="false" data-pc-name="pcinputtext" data-pc-extend="inputtext" pc27="" data-pc-section="root" value="15/10/2026"><!----><button class="p-datepicker-dropdown" disabled="" type="button" aria-label="Choose Date" aria-haspopup="dialog" aria-expanded="false" aria-controls="trace-date_panel" data-pc-section="dropdown"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="p-icon" aria-hidden="true" data-pc-section="dropdownicon"><path d="M10.7838 1.51351H9.83783V0.567568C9.83783 0.417039 9.77804 0.272676 9.6716 0.166237C9.56516 0.0597971 9.42079 0 9.27027 0C9.11974 0 8.97538 0.0597971 8.86894 0.166237C8.7625 0.272676 8.7027 0.417039 8.7027 0.567568V1.51351H5.29729V0.567568C5.29729 0.417039 5.2375 0.272676 5.13106 0.166237C5.02462 0.0597971 4.88025 0 4.72973 0C4.5792 0 4.43484 0.0597971 4.3284 0.166237C4.22196 0.272676 4.16216 0.417039 4.16216 0.567568V1.5135