exports[`rendu des écrans (aucun avertissement Vue) > CV 1`] = `"<div data-v-app=""><header><h1>Mon CV</h1><p>Il alimente le bloc « Curriculum vitæ » de vos portfolios.</p><button class="p-button p-component" data-p="" type="button" disabled="" aria-label="Enregistrer" data-pc-name="button" data-p-disabled="true" pc0="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-save" data-p="left" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="">Enregistrer</span><!----></button></header><div class="flex flex-col gap-4"><!--v-if--><section class="card p-4 flex flex-col gap-3"><h3 class="text-base font-semibold m-0">Présentation</h3><div class="flex flex-col gap-1"><label for="cv-poste" class="font-medium">Poste ou domaine recherché</label><input type="text" class="p-inputtext p-component p-filled" data-p="" id="cv-poste" maxlength="255" data-pc-name="inputtext" pc2="" data-pc-section="root" value="Intégrateur"></div><div class="flex flex-col gap-1"><label for="cv-desc" class="font-medium">Présentation</label><textarea class="p-textarea p-component p-filled p-textarea-resizable" data-p="" id="cv-desc" rows="4" maxlength="3000" data-pc-name="textarea" pc3="" data-pc-section="root" value="Alternant"></textarea></div></section><section class="card p-4 flex flex-col gap-3"><div class="flex items-center justify-between"><h3 class="text-base font-semibold m-0">Expériences</h3><button class="p-button p-component p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Ajouter" data-pc-name="button" data-p-disabled="false" pc4="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-plus" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Ajouter</span><!----></button></div><!--v-if--><div class="rounded-lg border border-surface-200 p-3 flex flex-col gap-2"><div class="grid gap-2 sm:grid-cols-2"><input typ