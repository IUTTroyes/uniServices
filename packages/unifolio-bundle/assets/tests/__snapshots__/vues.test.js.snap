exports[`rendu des écrans (aucun avertissement Vue) > édition d'une grille : grille nationale en lecture seule 1`] = `"<div data-v-app=""><header><h1>BUT — AC</h1><p>Apprentissage critique · Toutes</p><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc1="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Nationale</span></span><span class="p-tag p-component p-tag-success" data-p="success" data-pc-name="tag" pc2="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">v1 publiée</span></span><!--v-if--></header><div class="p-message p-component p-message-info mb-4" role="alert" aria-live="assertive" aria-atomic="true" data-p="info" data-pc-name="message" pc3="" data-pc-section="root"><div class="p-message-content-wrapper" data-pc-section="contentwrapper"><div class="p-message-content" data-p="info" data-pc-section="content"><!----><div class="p-message-text" data-p="info" data-pc-section="text"> Grille nationale en lecture seule. <button class="p-button p-component p-button-text p-button-sm" data-p="small text" type="button" aria-label="Adapter pour mon département" data-pc-name="button" data-p-disabled="false" pc4="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-copy" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Adapter pour mon département</span><!----></button></div><!----></div></div></div><div class="grid gap-4 xl:grid-cols-3"><div class="xl:col-span-2 flex flex-col gap-4"><!--v-if--><section class="card p-4 flex flex-col gap-3"><div class="flex items-center justify-between"><div><h3 class="text-base font-semibold m-0">Échelle</h3><p class="text-sm text-muted-color m-0">Commune à tous les critères « échelle » de la grille.</p></div><!--v-if--></div><div handle=".poignee" disabled="true" class="flex flex-col gap-2"><div class="flex flex-wrap items-center gap-2"><!--v-if--><span class="text-sm font-semibold px-2 py-1 rounded text-white" style="background: rgb(185, 28, 28);">Non acquis</span><span class="text-sm text-muted-color">valeur 0 — Non démontré</span></div><div class="flex flex-wrap items-center gap-2"><!--v-if--><span class="text-sm font-semibold px-2 py-1 rounded text-white" style="background: rgb(22, 163, 74);">Acquis</span><span class="text-sm text-muted-color">valeur 2<!--v-if--></span></div></div></section><section class="card p-4 flex flex-col gap-3"><div class="flex flex-wrap items-center justify-between gap-2"><h3 class="text-base font-semibold m-0">Critères</h3><!--v-if--></div><div handle=".poignee" disabled="true" class="flex flex-col gap-3"><div class="border rounded-lg p-3 flex flex-col gap-3 border-surface-200"><div class="flex flex-wrap items-center gap-2"><!--v-if--><span class="font-medium flex-1">Maîtrise</span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc5="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Échelle de niveaux</span></span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc6="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">poids 2</span></span></div><p class="text-sm m-0">Niveau</p><!--v-if--></div><div class="border rounded-lg p-3 flex flex-col gap-3 border-violet-300 bg-violet-50/40 dark:bg-violet-950/20"><div class="flex flex-wrap items-center gap-2"><span class="p-tag p-component p-tag-contrast" data-p="contrast" data-pc-name="tag" pc7="" data-pc-section="root"><span class="p-tag-icon pi pi-sparkles" data-pc-section="icon"></span><span class="p-tag-label" data-pc-section="label">IA</span></span><span class="font-medium flex-1">Usage de l'IA</span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc8="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Échelle de niveaux</span></span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc9="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">poids 1</span></span></div><!--v-if--><!--v-if--></div><div class="border rounded-lg p-3 flex flex-col gap-3 border-surface-200"><div class="flex flex-wrap items-center gap-2"><!--v-if--><span class="font-medium flex-1">Note</span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc10="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Note numérique</span></span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc11="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">poids 1</span></span></div><!--v-if--><p class="text-sm text-muted-color m-0">Indicateurs</p></div><div class="border rounded-lg p-3 flex flex-col gap-3 border-surface-200"><div class="flex flex-wrap items-center gap-2"><!--v-if--><span class="font-medium flex-1">Appréciation</span><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc12="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Appréciation libre</span></span><!--v-if--></div><!--v-if--><!--v-if--></div></div></section></div><div class="flex flex-col gap-4"><!--v-if--><section class="card p-4 flex flex-col gap-2"><h3 class="text-base font-semibold m-0">Historique</h3><div class="flex items-center justify-between text-sm"><span>Version 1</span><span class="p-tag p-component p-tag-success" data-p="success" data-pc-name="tag" pc13="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">publiée le 1 oct. 2026</span></span></div><div class="flex items-center justify-between text-sm"><span>Version 2</span><span class="p-tag p-component p-tag-warn" data-p="warn" data-pc-name="tag" pc14="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">brouillon</span></span></div></section><!--v-if--></div></div></div>"`;

exports[`rendu des écrans (aucun avertissement Vue) > édition d'une trace : brouillon modifiable avec erreurs de dépôt 1`] = `"<div data-v-app=""><header><h1>Modifier la trace</h1><p>Déposez vos preuves, décrivez votre démarche et reliez-les aux compétences de votre année.</p><span class="p-tag p-component p-tag-secondary" data-p="secondary" data-pc-name="tag" pc23="" data-pc-section="root"><!----><span class="p-tag-label" data-pc-section="label">Brouillon</span></span></header><!--v-if--><div class="grid gap-4 xl:grid-cols-3"><section class="card p-4 flex flex-col gap-3 xl:col-span-3"><div><h3 class="text-base font-semibold m-0">Preuves</h3><p class="text-sm text-muted-color m-0">Commencez par déposer ce que vous avez produit ; vous pourrez compléter la description ensuite.</p></div><div class="flex flex-col gap-4"><div class="rounded-xl border-2 border-dashed p-6 flex flex-col items-center gap-3 text-center transition-colors outline-none focus-visible:ring-2 border-surface-300" tabindex="0" role="region" aria-label="Zone de dépôt des preuves : glissez des fichiers ou collez une capture"><i class="pi pi-cloud-upload text-4xl text-emerald-600"></i><div><p class="font-medium m-0">Glissez vos fichiers ici</p><p class="text-sm text-muted-color m-0"> Images, PDF, vidéos, archives, documents… plusieurs à la fois. Le type est reconnu automatiquement. </p></div><div class="flex flex-wrap justify-center gap-2"><button class="p-button p-component p-button-sm" data-p="small" type="button" aria-label="Choisir des fichiers" data-pc-name="button" data-p-disabled="false" pc24="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-folder-open" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Choisir des fichiers</span><!----></button><button class="p-button p-component p-button-secondary p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Texte" data-pc-name="button" data-p-disabled="false" data-p-severity="secondary" pc25="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-align-left" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Texte</span><!----></button><button class="p-button p-component p-button-secondary p-button-outlined p-button-sm" data-p="small outlined" type="button" aria-label="Code" data-pc-name="button" data-p-disabled="false" data-p-severity="secondary" pc26="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-code" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Code</span><!----></button></div><input type="file" multiple="" class="hidden"><div class="flex w-full max-w-xl gap-2"><input type="text" class="p-inputtext p-component flex-1" data-p="" placeholder="…ou collez un lien (site, YouTube, Figma, dépôt Git…)" aria-label="Ajouter un lien" data-pc-name="inputtext" pc27="" data-pc-section="root"><button class="p-button p-component p-button-sm" data-p="small" type="button" disabled="" aria-label="Ajouter" data-pc-name="button" data-p-disabled="true" pc28="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-link" data-p="left small" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="small">Ajouter</span><!----></button></div><small class="text-muted-color">Astuce : cliquez dans cette zone puis collez (Ctrl/Cmd + V) une capture d'écran.</small></div><!--v-if--><!--v-if--><div handle=".poignee" disabled="false" class="grid gap-3 md:grid-cols-2"><div class="border border-surface-200 rounded-lg p-3 flex flex-col gap-2"><div class="flex items-center gap-2"><i class="pi pi-bars poignee cursor-move text-muted-color" title="Déplacer"></i><span class="flex-1 flex items-center gap-2 text-sm text-muted-color"><i class="pi pi-align-left"></i> Texte</span><button class="p-button p-component p-button-icon-only p-button-danger p-button-rounded p-button-text p-button-sm" data-p="small icon-only rounded text" type="button" aria-label="Supprimer la preuve" data-pc-name="button" data-p-disabled="false" data-p-severity="danger" pc29="" data-pc-section="root"><span class="p-button-icon pi pi-trash" data-p="left small" data-pc-section="icon"></span><!----><!----></button></div><!--v-if--><!--v-if--><!--v-if--><textarea class="p-textarea p-component p-filled p-textarea-resizable" data-p="" rows="4" aria-label="Contenu" data-pc-name="textarea" pc30="" data-pc-section="root" value="Compte rendu"></textarea><input type="text" class="p-inputtext p-component p-inputtext-sm p-inputfield-sm" data-p="small" placeholder="Légende (facultatif)" aria-label="Légende" data-pc-name="inputtext" pc31="" data-pc-section="root"></div></div></div></section><div class="xl:col-span-2 flex flex-col gap-4"><section class="card p-4 flex flex-col gap-4"><h3 class="text-base font-semibold m-0">Description</h3><div class="flex flex-col gap-2"><label for="trace-titre" class="font-medium">Titre *</label><input type="text" class="p-inputtext p-component p-filled" data-p="" id="trace-titre" maxlength="255" data-pc-name="inputtext" pc32="" data-pc-section="root" value="Maquette"></div><div class="grid gap-4 sm:grid-cols-3"><div class="flex flex-col gap-2"><label for="trace-annee" class="font-medium">Année de BUT</label><span id="trace-annee" class="py-2 font-medium">MMI - DWeb-DI - 2 — 2026-2027</span><!--v-if--></div><div class="flex flex-col gap-2"><label for="trace-date" class="font-medium">Date de réalisation</label><span id="trace-date" class="p-datepicker p-component p-inputwrapper p-inputwrapper-filled" data-p="" data-pc-name="datepicker" pc33="" data-pc-section="root"><input type="text" class="p-inputtext p-component p-filled p-datepicker-input" data-p="" id="pv_id_N" role="combobox" autocomplete="off" aria-autocomplete="none" aria-haspopup="dialog" aria-expande