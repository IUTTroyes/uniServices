exports[`rendu des écrans (aucun avertissement Vue) > progression vide 1`] = `"<div data-v-app=""><header><h1>Ma progression</h1><p>Les éléments du référentiel que vos traces démontrent, année par année.</p><button class="p-button p-component" data-p="" type="button" aria-label="Déposer une trace" data-pc-name="button" data-p-disabled="false" pc0="" data-pc-section="root"><span class="p-button-icon p-button-icon-left pi pi-plus" data-p="left" data-pc-section="icon"></span><span class="p-button-label" data-pc-section="label" data-p="">Déposer une trace</span><!----></button></header><div class="empty"><strong>Pas encore de progression</strong><span>Votre progression apparaîtra dès que vous serez inscrit·e dans une année de BUT et que vous aurez déposé des traces.</span></div></div>"`;

exports[`rendu des écrans (aucun avertissement Vue) > préférences de notification : interrupteur général coupé 1`] = `"<div data-v-app=""><header><h1>Notifications</h1><p>Choisissez ce que vous recevez par e-mail, et quand : tout de suite, regroupé dans un résumé, ou jamais.</p><!----></header><div class="grid gap-4 xl:grid-cols-3 items-start"><div class="xl:col-span-2 flex flex-col gap-4"><section class="card p-4 flex flex-col gap-4"><label class="flex items-center gap-3 cursor-pointer"><div class="p-toggleswitch p-component" style="position: relative;" data-pc-name="toggleswitch" pc1="" data-pc-section="root" data-p-checked="false" data-p-disabled="false" data-p=""><input id="notif-actif" type="checkbox" role="switch" class="p-toggleswitch-input" aria-checked="false" data-pc-section="input"><div class="p-toggleswitch-slider" data-pc-section="slider" data-p=""><div class="p-toggleswitch-handle" data-pc-section="handle" data-p=""></div></div></div><span class="flex flex-col"><span class="font-semibold">Recevoir des e-mails UniFolio</span><span class="text-sm text-muted-color">Désactivé : aucun e-mail ne vous est envoyé, ni immédiat ni résumé. Vous retrouvez tout dans l'application.</span></span></label><div class="p-message p-component p-message-warn" role="alert" aria-live="assertive" aria-atomic="true" data-p="warn" data-pc-name="message" pc2="" data-pc-section="root"><div class="p-message-content-wrapper" data-pc-section="contentwrapper"><div class="p-message-content" data-p="warn" data-pc-section="content"><!----><div class="p-message-text" data-p="warn" data-pc-section="text">Les notifications par e-mail sont désactivées.</div><!----></div></div></div></section><section class="card p-4 flex flex-col gap-4 opacity-60"><h3 class="text-base font-semibold m-0">Que voulez-vous recevoir ?</h3><div class="flex flex-wrap items-center justify-between gap-3 border-b border-surface-100 pb-4 last:border-0 last:pb-0"><div class="flex flex-col min-w-60 flex-1"><span class="f