{
  "name": "iuttroyes/document-bundle",
  "type": "symfony-bundle",
  "description": "Document management (GED) bundle for uniServices",
  "require": {
    "php": "^8.4",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "doctrine/orm": "*",
    "doctrine/doctrine-bundle": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "DocumentBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DocumentBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  }
}
