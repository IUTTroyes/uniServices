{% extends 'emails/layout.html.twig' %}

{% block preheader %}{{ reponses }} réponse(s) sur {{ invites }} pour « {{ questionnaire_titre }} ».{% endblock %}

{% block body %}
    <h1>Votre questionnaire est terminé</h1>

    <p>Bonjour{% if destinataire_nom %} {{ destinataire_nom }}{% endif %},</p>

    <p>Le questionnaire <strong>{{ questionnaire_titre }}</strong> est clôturé.</p>

    <p>
        Réponses envoyées : <strong>{{ reponses }} / {{ invites }}</strong> ({{ taux }} %).<br>
        {% if complet %}Tous les participants ont répondu.{% elseif date_atteinte and date_cloture %}La date limite ({{ date_cloture }}) est atteinte.{% endif %}
    </p>

    <p><a href="{{ lien }}" class="btn">Consulter les résultats</a></p>

    <p>Les résultats peuvent être exportés en PDF ou Excel depuis cette page.</p>
{% endblock %}
