{% extends 'emails/layout.html.twig' %}

{% block preheader %}Vous êtes invité(e) à répondre au questionnaire « {{ questionnaire_titre }} ».{% endblock %}

{% block body %}
    <h1>Votre avis est attendu</h1>

    <p>Bonjour,</p>

    <p>Vous êtes invité(e) à répondre au questionnaire <strong>{{ questionnaire_titre }}</strong>.</p>

    {% if questionnaire_description %}
    <p><em>{{ questionnaire_description }}</em></p>
    {% endif %}

    <p>
        {% if duree_estimee %}Cela vous prendra environ {{ duree_estimee }} minute(s). {% endif %}
        {% if anonyme %}Vos réponses sont anonymes.{% endif %}
    </p>

    <p><a href="{{ lien }}" class="btn">Répondre au questionnaire</a></p>

    {% if date_cloture %}
    <div class="alert">Le questionnaire est ouvert jusqu'au <strong>{{ date_cloture }}</strong>.</div>
    {% endif %}

    <hr class="divider">

    <p>Ce lien vous est personnel : ne le transférez pas. S'il ne s'ouvre pas, copiez-le dans votre navigateur :<br>{{ lien }}</p>
{% endblock %}
