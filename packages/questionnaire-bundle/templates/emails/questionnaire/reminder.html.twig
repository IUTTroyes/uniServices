{% extends 'emails/layout.html.twig' %}

{% block preheader %}Vous n'avez pas encore envoyé vos réponses au questionnaire « {{ questionnaire_titre }} ».{% endblock %}

{% block body %}
    <h1>Rappel : votre avis est attendu</h1>

    <p>Bonjour,</p>

    {% if message %}
    <p>{{ message|nl2br }}</p>
    {% else %}
    <p>Vous n'avez pas encore envoyé vos réponses au questionnaire <strong>{{ questionnaire_titre }}</strong>. Votre participation compte.</p>
    {% endif %}

    <p><a href="{{ lien }}" class="btn">Répondre au questionnaire</a></p>

    {% if date_cloture %}
    <div class="alert">Le questionnaire ferme le <strong>{{ date_cloture }}</strong>.</div>
    {% endif %}

    <hr class="divider">

    <p>Ce lien vous est personnel. S'il ne s'ouvre pas, copiez-le dans votre navigateur :<br>{{ lien }}</p>
{% endblock %}
