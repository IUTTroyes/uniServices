{
  "name": "iuttroyes/finance-bundle",
  "type": "symfony-bundle",
  "description": "FinanceBundle for uniServices - Gestion des bons de commandes, réceptions et tableau de bord financier",
  "require": {
    "php": "^8.2",
    "symfony/framework-bundle": "^7.0",
    "symfony/http-kernel": "^7.0",
    "doctrine/orm": "*",
    "doctrine/doctrine-bundle": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "FinanceBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FinanceBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.0.*"
    }
  }
}
