<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Demandes d'achat</title>
</head>
<body>
{# Export du tableau de bord Finances : une ligne par demande, dans l'ordre affiché (filtres et tri appliqués). #}
{# Les textes saisis sont écrits en type « string » : jamais interprétés comme formules. #}
{% set entete = 'data-xls-border="thin" data-xls-bg-color="#047857" data-xls-font-color="#FFFFFF" data-xls-font-bold="true"' %}
<table data-xls-sheet="Demandes d'achat" data-xls-autosize="true" data-xls-freeze="A2" data-xls-autofilter="A1:L{{ max(commandes|length + 1, 2) }}">
    <thead>
        <tr>
            <th {{ entete|raw }}>Référence</th>
            <th {{ entete|raw }}>Centre financier</th>
            <th {{ entete|raw }}>Objet</th>
            <th {{ entete|raw }}>Prestation</th>
            <th {{ entete|raw }}>Fournisseur</th>
            <th {{ entete|raw }}>Imputation</th>
            <th {{ entete|raw }}>Type</th>
            <th {{ entete|raw }}>Demandeur</th>
            <th {{ entete|raw }}>Montant HT</th>
            <th {{ entete|raw }}>Montant TTC</th>
            <th {{ entete|raw }}>Statut</th>
            <th {{ entete|raw }}>Demandée le</th>
        </tr>
    </thead>
    <tbody>
    {% for c in commandes %}
        {% set fournisseur = c.fournisseur ? c.fournisseur.nomFournisseur : (c.fournisseurPropose ? c.fournisseurPropose ~ ' (proposé)' : '') %}
        <tr>
            <td data-xls-border="thin" data-xls-type="string">{{ c.numeroBonCommande ? 'BC ' ~ c.numeroBonCommande : 'Demande n° ' ~ c.id }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.centreFinancier }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.objetDemande }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.prestation.label }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ fournisseur }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.imputationLibelle }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.service ? 'Service' : (c.departement ? 'Département' : '') }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.demandeur ? (c.demandeur.prenom ~ ' ' ~ c.demandeur.nom)|trim : '' }}</td>
            <td data-xls-border="thin" data-xls-type="number" data-xls-format="#,##0.00 €">{{ c.montantHt }}</td>
            <td data-xls-border="thin" data-xls-type="number" data-xls-format="#,##0.00 €">{{ c.montantTtc ?? c.montantHt }}</td>
            <td data-xls-border="thin" data-xls-type="string">{{ c.statut.label }}</td>
            <td data-xls-border="thin" data-xls-type="date" data-xls-format="dd/mm/yyyy">{{ c.dateDemande ? c.dateDemande|date('Y-m-d') : '' }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>
