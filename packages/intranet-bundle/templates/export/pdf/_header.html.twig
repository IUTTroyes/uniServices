<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 8pt;
            color: #64748b;
            margin: 0;
            padding: 0 10mm;
            width: 100%;
            box-sizing: border-box;
            background: transparent;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #cbd5e1;
            padding-bottom: 4px;
            width: 100%;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .header-brand {
            font-weight: 800;
            color: #0284c7;
            font-size: 8.5pt;
            letter-spacing: -0.2px;
        }
        .header-title {
            font-weight: 600;
            color: #1e293b;
            font-size: 8pt;
        }
        .header-subtitle {
            color: #64748b;
            font-size: 7.5pt;
        }
        .header-right {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 7.5pt;
            color: #475569;
            text-align: right;
        }
        .sep {
            color: #cbd5e1;
            margin: 0 3px;
        }
    </style>
</head>
<body>
    <div class="header-container">
        <div class="header-left">
            <span class="header-brand">{{ etablissement|default('IUT de Troyes') }}</span>
            {% if title is defined and title %}
                <span class="sep">•</span>
                <span class="header-title">{{ title }}</span>
            {% endif %}
            {% if subtitle is defined and subtitle %}
                <span class="sep">•</span>
                <span class="header-subtitle">{{ subtitle }}</span>
            {% endif %}
        </div>
        <div class="header-right">
            {% if departement is defined and departement %}
                <span>{{ departement }}</span>
            {% endif %}
            {% if anneeUniversitaire is defined and anneeUniversitaire %}
                {% if departement is defined and departement %}<span class="sep">•</span>{% endif %}
                <span>{{ anneeUniversitaire }}</span>
            {% endif %}
        </div>
    </div>
</body>
</html>
