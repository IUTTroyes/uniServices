<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <php>
        <!-- Les tests d'API de plusieurs packages démarrent chacun un noyau Symfony en mode debug. -->
        <ini name="memory_limit" value="512M"/>
    </php>
    <testsuites>
        <testsuite name="Core">
            <directory>tests/Notification</directory>
            <directory>tests/Email</directory>
            <directory>tests/Security</directory>
        </testsuite>
        <testsuite name="MessageBundle">
            <directory>packages/message-bundle/tests</directory>
        </testsuite>
        <testsuite name="UnifolioBundle">
            <directory>packages/unifolio-bundle/tests</directory>
        </testsuite>
        <testsuite name="StageBundle">
            <directory>packages/stage-bundle/tests</directory>
        </testsuite>
        <testsuite name="QuestionnaireBundle">
            <directory>packages/questionnaire-bundle/tests</directory>
        </testsuite>
        <testsuite name="FinanceBundle">
            <directory>packages/finance-bundle/tests</directory>
        </testsuite>
    </testsuites>
</phpunit>

